{
    "name": "hexlab",
    "displayName": "HexLab",
    "description": "Advanced Android Reverse-Engineering Workbench — forked from APKLab",
    "publisher": "HexLab",
    "version": "1.7.1",
    "license": "SEE LICENSE IN LICENSE",
    "icon": "assets/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "homepage": "https://github.com/Mkadir/APKLab",
    "repository": {
        "type": "git",
        "url": "https://github.com/Mkadir/APKLab.git"
    },
    "bugs": {
        "url": "https://github.com/Mkadir/APKLab/issues"
    },
    "extensionDependencies": [
        "LoyieKing.smalise"
    ],
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "bytecode",
        "disassembler",
        "decompiler",
        "re",
        "android",
        "apktool",
        "jadx",
        "apksigner",
        "apk",
        "reverse engineering",
        "analysis",
        "apk editor",
        "smali",
        "dalvik"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension",
    "contributes": {
        "commands": [
            {
                "command": "apklab.openApkFile",
                "title": "APKLab: Open an APK"
            },
            {
                "command": "apklab.rebuildApkFile",
                "title": "APKLab: Rebuild the APK"
            },
            {
                "command": "apklab.patchApkForHttps",
                "title": "APKLab: Prepare for HTTPS inspection"
            },
            {
                "command": "apklab.patchApkForRootBypass",
                "title": "APKLab: Patch APK for Root Bypass"
            },
            {
                "command": "apklab.installApkFile",
                "title": "APKLab: Install the APK"
            },
            {
                "command": "apklab.rebuildAndInstallApkFile",
                "title": "APKLab: Rebuild and Install the APK"
            },
            {
                "command": "apklab.emptyFrameworkDir",
                "title": "APKLab: Empty ApkTool Framework Dir"
            },
            {
                "command": "apklab.uninstallApp",
                "title": "APKLab: ADB Uninstall App"
            },
            {
                "command": "apklab.launchApp",
                "title": "APKLab: ADB Launch App"
            },
            {
                "command": "apklab.logcatApp",
                "title": "APKLab: ADB Stream Logcat"
            },
            {
                "command": "apklab.quarkReport",
                "title": "APKLab: Show Quark analysis report"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "apklab.rebuildApkFile",
                    "when": "false"
                },
                {
                    "command": "apklab.installApkFile",
                    "when": "false"
                },
                {
                    "command": "apklab.rebuildAndInstallApkFile",
                    "when": "false"
                },
                {
                    "command": "apklab.patchApkForHttps",
                    "when": "false"
                },
                {
                    "command": "apklab.patchApkForRootBypass",
                    "when": "false"
                },
                {
                    "command": "apklab.quarkReport",
                    "when": "false"
                }
            ],
            "editor/context": [
                {
                    "command": "apklab.rebuildApkFile",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.rebuildAndInstallApkFile",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.patchApkForHttps",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.patchApkForRootBypass",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.quarkReport",
                    "when": "resourceFilename == quarkReport.json",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "apklab.rebuildApkFile",
                    "when": "resourceFilename == apktool.yml"
                },
                {
                    "command": "apklab.rebuildAndInstallApkFile",
                    "when": "resourceFilename == apktool.yml"
                },
                {
                    "command": "apklab.patchApkForHttps",
                    "when": "resourceFilename == apktool.yml"
                },
                {
                    "command": "apklab.patchApkForRootBypass",
                    "when": "resourceFilename == apktool.yml"
                },
                {
                    "command": "apklab.quarkReport",
                    "when": "resourceFilename == quarkReport.json"
                }
            ],
            "explorer/context": [
                {
                    "command": "apklab.installApkFile",
                    "when": "resourceExtname == .apk",
                    "group": "navigation"
                },
                {
                    "command": "apklab.rebuildApkFile",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.rebuildAndInstallApkFile",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.patchApkForHttps",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.patchApkForRootBypass",
                    "when": "resourceFilename == apktool.yml",
                    "group": "navigation"
                },
                {
                    "command": "apklab.quarkReport",
                    "when": "resourceFilename == quarkReport.json",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "APKLab",
            "properties": {
                "apklab.apktoolPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Put the absolute path of `apktool.jar` here if you want to use a non-latest version."
                },
                "apklab.apkSignerPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Put the absolute path of `uber-apk-signer.jar` here if you want to use a non-latest version."
                },
                "apklab.jadxDirPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Put the absolute path of `jadx-x.y.z` dir here if you want to use a non-latest version."
                },
                "apklab.updateTools": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Whether APKLab should check for tools (for apklab, jadx...) update and show a notification."
                },
                "apklab.keystorePath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Put the absolute path of your **Java keystore**(`.jks` or `.keystore`) file here."
                },
                "apklab.keystorePassword": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Put the **password** of your keystore here."
                },
                "apklab.keyAlias": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Put the **alias** of the used key in the keystore here."
                },
                "apklab.keyPassword": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Put the **password** of the used key in the keystore here."
                },
                "apklab.initProjectDirAsGit": {
                    "type": "boolean",
                    "default": "false",
                    "markdownDescription": "Initialize project output directory as **Git** repository."
                },
                "apklab.jvmHeapSize": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Provide JVM Max Heap Size constraints for decompiling extremely large packages (e.g. `-Xmx4g`). Leave blank for default."
                },
                "apklab.rootBypassVerifyRebuild": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "After root bypass patching, run an immediate Apktool rebuild verification to catch smali issues early."
                },
                "apklab.rootBypassScope": {
                    "type": "string",
                    "enum": [
                        "app-only",
                        "all"
                    ],
                    "default": "app-only",
                    "markdownDescription": "Scope for root/emulator bypass patching. `app-only` patches only classes under your app package from AndroidManifest.xml. `all` scans every smali class, including third-party libraries."
                },
                "apklab.rootBypassAdditionalPackages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Additional Java package prefixes to include when `apklab.rootBypassScope` is `app-only` (for example SDK namespaces like `uz.myid.android.sdk`)."
                }
            }
        }
    },
    "scripts": {
        "lint": "eslint src --ext ts && prettier --check .",
        "fix": "prettier --write . && eslint src --ext ts --fix",
        "clean": "rm -rf out dist",
        "pretest": "tsc -p ./",
        "test": "node ./out/test/runTest.js",
        "watch": "node esbuild.config.mjs --watch",
        "vscode:prepublish": "npm run clean && node esbuild.config.mjs --production",
        "package": "vsce package"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/adm-zip": "^0.5.8",
        "@types/cross-spawn": "^6.0.6",
        "@types/glob": "^9.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/listr": "^0.14.10",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24",
        "@types/vscode": "^1.75.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.7.0",
        "esbuild": "^0.26.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "glob": "^11.0.3",
        "mocha": "^11.7.5",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3"
    },
    "dependencies": {
        "adm-zip": "^0.5.16",
        "apk-mitm": "^1.3.0",
        "cross-spawn": "^7.0.6",
        "js-yaml": "^4.1.1",
        "yarn": "^1.22.22"
    }
}
